# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth2 (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/cass.db

# Sandboxed file access directories (comma-separated)
ALLOWED_DIRECTORIES=~/Documents,~/Downloads

# Assistant defaults (overridden during onboarding)
ASSISTANT_NAME=Cass
